---
import { pokemonById } from '../data/pokemon';
import PokemonSprite from './PokemonSprite';
interface Props { current: string; chain: {id: string; condition: string}[] }
const { current, chain } = Astro.props;
const colors: Record<string,string> = {Fire:'#efb17e',Water:'#a7d9e8',Electric:'#eed071',Grass:'#b9d49f',Ghost:'#c8b4dc',Dragon:'#b6c7e7',Steel:'#bdcbd1',Fairy:'#e7bfd2',Ground:'#d7c395',Bug:'#cbd39b',Normal:'#d9ceba',Fighting:'#ddbaa4',Flying:'#c3d8e7',Dark:'#bcb7cf',Psychic:'#dfb5ce',Ice:'#bce0dd',Rock:'#cfc3a5',Poison:'#d1b5d9'};
---
<div class="evolution-cards" aria-label="Evolution collection">
{chain.map((step,i)=>{const p=pokemonById.get(step.id)!; return <div class:list={['evolution-stage',{current:p.id===current}]}>
<button type="button" class="holo-card" style={`--card-tint:${colors[p.types[0]]??'#eed071'}`} aria-label={`${p.name} holographic Pokédex card. Activate to animate, or use arrow keys to tilt.`}>
<div class="card-paper"><div class="collection-label">POKÉDEX COLLECTION <span aria-hidden="true">✦</span></div><h2 class="card-name">{p.name}</h2><span class="card-types">{p.types.join(' / ')}</span><div class="card-art"><span class="card-number" aria-hidden="true">{String(p.number).padStart(3,'0')}</span><PokemonSprite pokemon={p} size="large" eager={true}/></div><div class="card-caption"><span>GENERATION {p.generation}</span><span>No. {String(p.number).padStart(4,'0')}</span></div></div><span class="card-foil" aria-hidden="true"></span><span class="card-glare" aria-hidden="true"></span>
</button>
<p class="evolution-condition">{i < chain.length-1 ? <>{chain[i+1].condition}<span aria-hidden="true"> →</span><small>To {pokemonById.get(chain[i+1].id)!.name}</small></> : <>{p.name}<small>{chain.length===1?'No evolution shown':'Last stage shown'}</small></>}</p>
</div>})}
</div>
<script>
document.querySelectorAll<HTMLButtonElement>('.holo-card').forEach(card=>{
 const reduced=matchMedia('(prefers-reduced-motion: reduce)');let frame=0;
 const set=(x:number,y:number)=>{card.style.setProperty('--light-x',`${x*100}%`);card.style.setProperty('--light-y',`${y*100}%`);card.style.setProperty('--tilt-x',`${(.5-y)*18}deg`);card.style.setProperty('--tilt-y',`${(x-.5)*22}deg`)};
 const reset=()=>{cancelAnimationFrame(frame);set(.5,.4);card.style.setProperty('--tilt-x','0deg');card.style.setProperty('--tilt-y','0deg')};
 card.addEventListener('pointermove',e=>{if(reduced.matches||e.pointerType==='touch')return;cancelAnimationFrame(frame);const r=card.getBoundingClientRect();set(Math.max(0,Math.min(1,(e.clientX-r.left)/r.width)),Math.max(0,Math.min(1,(e.clientY-r.top)/r.height)))});
 card.addEventListener('pointerleave',reset);card.addEventListener('pointercancel',reset);card.addEventListener('blur',reset);
 card.addEventListener('click',()=>{if(reduced.matches)return;cancelAnimationFrame(frame);const start=performance.now();const tick=(t:number)=>{const p=Math.min(1,(t-start)/1400);set(.5+Math.sin(p*Math.PI*2)*.4,.5+Math.cos(p*Math.PI*2)*.3);if(p<1)frame=requestAnimationFrame(tick);else reset()};frame=requestAnimationFrame(tick)});
 card.addEventListener('keydown',e=>{const directions:Record<string,[number,number]>={ArrowLeft:[.1,.5],ArrowRight:[.9,.5],ArrowUp:[.5,.1],ArrowDown:[.5,.9]};if(directions[e.key]&&!reduced.matches){e.preventDefault();cancelAnimationFrame(frame);set(...directions[e.key])}if(e.key==='Escape')reset()});
 reduced.addEventListener('change',reset);window.addEventListener('pagehide',reset);
});
</script>
<style>
.evolution-cards{display:flex;align-items:center;justify-content:center;gap:16px;padding:8px 5px 0;min-width:0}.evolution-stage{flex:1;max-width:216px;min-width:0;perspective:950px}.evolution-stage:not(.current){transform:scale(.94)}.holo-card{--light-x:50%;--light-y:40%;--tilt-x:0deg;--tilt-y:0deg;position:relative;display:block;width:100%;aspect-ratio:.716;padding:7px;border:1px solid #ad8738;border-radius:15px;color:#392c15;background:linear-gradient(130deg,#fff0ad,#b18a36 35%,#ffe5a2 67%,#b68d31);box-shadow:0 18px 25px -19px #6e573a99;transform:rotateX(var(--tilt-x)) rotateY(var(--tilt-y));transition:transform .15s ease-out;text-align:left;overflow:hidden;isolation:isolate;cursor:pointer}.holo-card:focus-visible{outline:3px solid #1765ad;outline-offset:4px}.current .holo-card{box-shadow:0 18px 28px -17px #91701a99}.card-paper{position:relative;height:100%;padding:12px;border:1px solid #9c7c3150;border-radius:9px;background:linear-gradient(145deg,#fff7d9,var(--card-tint),#f5ebca);display:flex;flex-direction:column}.card-paper:before{content:'';position:absolute;inset:0;pointer-events:none;background:repeating-linear-gradient(45deg,transparent 0 7px,#78602109 8px 9px)}.collection-label{display:flex;justify-content:space-between;font-size:8px;letter-spacing:.6px}.card-name{font-size:clamp(14px,2vw,23px);letter-spacing:-.5px;line-height:1.2;margin:12px 0 6px;overflow-wrap:anywhere}.card-types{font-size:10px}.card-art{position:relative;display:flex;align-items:center;justify-content:center;flex:1;min-height:0;background:radial-gradient(ellipse,#fffad4a0,transparent 70%)}.card-number{position:absolute;font-size:75px;font-weight:700;letter-spacing:-7px;opacity:.07}.card-art :global(.pokemon-sprite){position:relative;width:100%;height:auto;aspect-ratio:1;filter:drop-shadow(0 9px 5px #62492330)}.card-caption{position:relative;display:flex;justify-content:space-between;gap:5px;padding-top:9px;border-top:1px solid #98752f66;font-size:8px;letter-spacing:.2px}.card-foil,.card-glare{position:absolute;inset:0;pointer-events:none;border-radius:inherit}.card-foil{mix-blend-mode:color-dodge;opacity:.45;background:linear-gradient(115deg,transparent 8%,#80d9e08a 24%,#bda0ef88 36%,#f7b6ca80 45%,#fff2acaa 55%,#95e5cb88 66%,transparent 80%);background-size:230% 230%;background-position:var(--light-x) var(--light-y)}.card-glare{background:radial-gradient(circle at var(--light-x) var(--light-y),#ffffff99,transparent 58%);mix-blend-mode:soft-light}.evolution-condition{text-align:center;font-size:11px;line-height:1.6;margin:12px 0 0;min-height:52px;color:#4e6070}.evolution-condition small{display:block;font-size:10px;color:#687888}@media(max-width:600px){.evolution-cards{gap:7px;padding:4px 0 0}.holo-card{padding:4px;border-radius:10px}.card-paper{padding:7px;border-radius:6px}.collection-label{font-size:6px;letter-spacing:0}.card-name{font-size:15px;margin-top:9px}.card-types{font-size:9px}.card-caption{font-size:7px;letter-spacing:0;flex-wrap:wrap;padding-top:6px}.card-number{font-size:45px;letter-spacing:-4px}.evolution-condition{font-size:10px;min-height:60px}.evolution-condition small{font-size:9px}}@media(prefers-reduced-motion:reduce){.holo-card{transform:none;transition:none}}
</style>
