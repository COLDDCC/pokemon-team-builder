---
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import ToolContent from '../components/ToolContent.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import TeamBuilder from '../components/TeamBuilder';
---
<BaseLayout>
  <SiteHeader home/>
  <main id="main" class="compact-home">
    <TeamBuilder client:load />
    <div class="features"><article><span>01</span><h2>Choose your team</h2><p>Six slots, a searchable Pokémon list, and instant team analysis.</p></article><article><span>02</span><h2>Understand the gaps</h2><p>Clear explanations of weaknesses, coverage, and team synergy.</p></article><article><span>03</span><h2>Find your next pick</h2><p>Recommendations based on the same explainable scoring rules.</p></article></div>
    <ToolContent/>
  </main>
  <SiteFooter/>
</BaseLayout>
