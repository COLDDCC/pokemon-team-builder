---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import PokemonSprite from '../../components/PokemonSprite';
import { featuredPokemonIds } from '../../config/seo-pages';
import { pokemonById } from '../../data/pokemon';
---
<BaseLayout title="Pokémon Team Guides | Super Pokémon Team Builder" description="Explore 18 Pokémon build guides with starter movesets, evolution chains, type weaknesses and teammate ideas."><SiteHeader/><main id="main"><h1>Pokémon team guides</h1><p>Choose a Pokémon to explore its stats, type matchups and recommended teammates.</p><div class="guide-grid">{featuredPokemonIds.map(id=>{const p=pokemonById.get(id)!;return <a class="guide-card" href={`/pokemon/${id}`}><PokemonSprite pokemon={p} size="large"/><h2>{p.name}</h2><p>{p.types.join(' / ')}</p><span>Build around {p.name} →</span></a>;})}</div><section class="seo-content"><h2>What these guides cover</h2><p>Each guide explains a casual Generation 9 starter moveset, item, ability and nature, plus type matchups, evolution and teammate ideas. Try the Pokémon in the team builder or follow a teammate’s guide. These examples do not include EV spreads or Tera types and are not ranked-format recommendations.</p></section></main><SiteFooter/></BaseLayout>
