---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import SiteHeader from '../../../components/SiteHeader.astro';
import SiteFooter from '../../../components/SiteFooter.astro';
import TeamBuilder from '../../../components/TeamBuilder';
import { featuredPokemonIds } from '../../../config/seo-pages';
import { pokemonById } from '../../../data/pokemon';
import PokemonSprite from '../../../components/PokemonSprite';
import TypeIcon from '../../../components/TypeIcon';
import { guideVisuals } from '../../../data/guide-visuals';
import { pokemonGuides } from '../../../data/guides';
import { analyzeTeam } from '../../../lib/scoring';
export function getStaticPaths() { return featuredPokemonIds.map(slug => ({ params: {slug}, props: {pokemon: pokemonById.get(slug)!} })); }
const { pokemon: p } = Astro.props;
const guide = pokemonGuides[p.id];
const alternative = pokemonById.get(guide.alternative)!;
const analysis = analyzeTeam([p]);
const weak = analysis.defense.filter(row => row.weak.length);
const resist = analysis.defense.filter(row => row.resist.length);

const visual = guideVisuals[p.id];
---
<BaseLayout title={`${p.name} Build Guide, Team Builder & Evolution | Super Pokémon Team Builder`} description={`Build around ${p.name}: starter moveset, item, ability, type weaknesses, teammate ideas and evolution. Try your team in the interactive builder.`}>
<SiteHeader/><main id="main" class="guide-page">
<section class="guide-hero"><PokemonSprite pokemon={p} size="large" eager/><div><p class="eyebrow">POKÉDEX #{String(p.number).padStart(3,'0')} · GENERATION {p.generation}</p><h1>{p.name} Build Guide</h1><div class="type-row">{p.types.map(type=><span><TypeIcon type={type}/>{type}</span>)}</div><p class="role">{guide.role}</p><a class="guide-cta" href="#build-team">Build a team with {p.name} ↓</a></div></section>
<nav class="guide-jumps" aria-label="Guide sections"><a href="#loadout">Moveset</a><a href="#partners">Teammates</a><a href="#matchups">Weaknesses</a><a href="#evolution">Evolution</a></nav>
<section id="loadout" class="guide-panel"><h2>Starter moveset</h2><p class="scope">Generation 9 · casual singles · base form</p><div class="loadout"><div><small>ITEM</small><strong>{guide.item}</strong></div><div><small>ABILITY</small><strong>{guide.ability}</strong></div><div><small>NATURE</small><strong>{guide.nature}</strong></div></div><div class="move-grid">{guide.moves.map((move,i)=><div><span>{i+1}</span><strong>{move}</strong></div>)}</div><div class="advice-grid"><article><h3>How to play</h3><p>{guide.plan}</p></article><article class="watch"><h3>Watch out for</h3><p>{guide.caution}</p></article></div><details><summary>About this example</summary><p>This editorial starting point is not a ranked-format recommendation or a legality check. It does not specify EVs or Tera type. Moves, items and abilities here do not change the builder score.</p></details></section>
<section id="partners" class="guide-panel"><h2>Teammate ideas</h2><p>{guide.partners}</p><div class="partner-grid">{visual.partners.map(partner=>{const member=pokemonById.get(partner.id)!;return <article><PokemonSprite pokemon={member}/><h3>{member.name}</h3><p>{partner.reason}</p><div class="partner-actions">{featuredPokemonIds.some(id => id === member.id) && <a href={`/pokemon/${member.id}`}>Read {member.name} guide →</a>}<a href={`/?v=1&team=${p.id},${member.id}`}>Try this pair →</a></div></article>})}</div><p class="scope">These are typing-based starting pairs, not a complete competitive team. Check the remaining four slots and your game’s rules.</p><a href={`/pokemon/${p.id}/best-teammates`}>Compare computed teammate suggestions →</a><details><summary>Alternative: {alternative.name}</summary><p>{guide.alternativeReason}</p>{featuredPokemonIds.some(id => id === alternative.id) && <p><a href={`/pokemon/${alternative.id}`}>Read {alternative.name} guide →</a></p>}<a href={`/?team=${alternative.id}`}>Try {alternative.name} →</a></details></section>
<section id="matchups" class="guide-panel"><h2>Type matchups</h2><h3>Weak to</h3><div class="matchup-row">{weak.map(row=><span class:list={['matchup',{'danger':row.multipliers[0]>=4}]}><TypeIcon type={row.type}/>{row.type}<strong>{row.multipliers[0]}×</strong></span>)}</div><details><summary>Resistances and immunities</summary><div class="matchup-row">{resist.map(row=><span class="matchup"><TypeIcon type={row.type}/>{row.type}<strong>{row.multipliers[0]}×</strong></span>)}</div></details><p class="scope">Typing only. Abilities, items and battle effects can change these matchups.</p><div class="stats-grid">{Object.entries(p.stats).map(([name,value])=><div><span>{({hp:'HP',atk:'Attack',def:'Defense',spa:'Sp. Attack',spd:'Sp. Defense',spe:'Speed'} as Record<string,string>)[name]}</span><strong>{value}</strong></div>)}</div></section>
<section id="evolution" class="guide-panel"><h2>Evolution chain</h2><ol class="evolution-chain">{visual.evolution.map(step=>{const member=pokemonById.get(step.id)!;return <li class:list={{current:member.id===p.id}}>{step.condition&&<p class="evo-condition">{step.condition}</p>}<PokemonSprite pokemon={member}/><strong>{member.name}</strong><span>#{String(member.number).padStart(3,'0')}</span></li>})}</ol><p class="scope">Standard main-series evolution conditions. Regional forms and games with special evolution systems can differ.</p></section>
<section id="build-team"><h2>Build your {p.name} team</h2><p>Start with {p.name}. Add teammates and compare your type-and-base-stat score.</p><TeamBuilder initialPokemon={p.id} client:visible/></section>
<section class="guide-panel"><details><summary>Sources &amp; guide notes</summary><p>Starter advice written for this guide; mechanics checked against Pokémon Showdown’s Generation 9 data.</p><ul><li><a href={`https://www.smogon.com/dex/sv/pokemon/${p.id}/`}>Smogon: format-specific strategy</a></li><li><a href={`https://pokemondb.net/pokedex/${p.id}`}>Pokémon Database: moves and evolution</a></li><li><a href="https://github.com/smogon/pokemon-showdown/tree/master/data">Pokémon Showdown mechanics data</a></li></ul><p>Reviewed October 5, 2026. <a href={`/feedback?from=/pokemon/${p.id}`}>Suggest a correction</a>.</p></details></section>
</main><SiteFooter/></BaseLayout>
<style>
.guide-page{max-width:1080px}.guide-hero{display:flex;align-items:center;gap:32px;padding:20px 0}.guide-hero :global(.pokemon-sprite){width:180px;height:180px;flex-shrink:0}.guide-hero h1{margin:8px 0;font-size:clamp(1.8rem,4vw,2.8rem)}.type-row,.matchup-row{display:flex;flex-wrap:wrap;gap:10px}.type-row>span,.matchup{display:inline-flex;align-items:center;gap:7px}.role{font-weight:650;font-size:1.1rem}.guide-cta{display:inline-block;background:#1765ad;color:white;padding:10px 16px;border-radius:10px;text-decoration:none}.guide-jumps{display:flex;gap:20px;flex-wrap:wrap;padding:14px 0}.guide-panel{border:1px solid #dce5ed;background:white;border-radius:18px;padding:24px;margin:20px 0;scroll-margin-top:16px}.guide-panel h2{margin-top:0}.scope{font-size:.88rem;color:#536477}.loadout{display:grid;grid-template-columns:repeat(3,1fr);gap:12px}.loadout>div{background:#f0f6fc;padding:14px;border-radius:12px}.loadout small,.loadout strong{display:block}.loadout small{color:#52677e;font-size:.72rem;margin-bottom:7px}.move-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:10px;margin-top:16px}.move-grid>div{border:1px solid #dce5ed;border-radius:10px;padding:12px;display:flex;gap:10px;align-items:center}.move-grid span{color:#1765ad;font-weight:700}.advice-grid,.partner-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:16px}.advice-grid article{padding:16px;background:#f5f8fc;border-radius:12px;margin-top:16px}.advice-grid h3{margin:0}.watch{background:#fff7e8!important}.guide-panel details{margin-top:16px}.guide-panel summary{cursor:pointer;font-weight:600}.matchup{padding:8px 12px;background:#f0f5fa;border-radius:10px}.danger{background:#fff0ed;border:1px solid #e9b6ac}.matchup strong{margin-left:6px}.partner-actions{display:flex;flex-wrap:wrap;gap:12px}.partner-grid article{border:1px solid #dce5ed;border-radius:14px;padding:18px}.partner-grid :global(.pokemon-sprite){width:90px;height:90px}.partner-grid h3{margin:5px 0}.evolution-chain{list-style:none;padding:0;display:flex;align-items:stretch;gap:16px}.evolution-chain li{flex:1;position:relative;display:flex;align-items:center;flex-direction:column;background:#f5f8fc;border:1px solid #dce5ed;border-radius:14px;padding:16px;text-align:center}.evolution-chain li+li::before{content:'→';position:absolute;left:-14px;top:50%;color:#1765ad}.evolution-chain .current{background:#fff8dc;border-color:#e4ca63}.evolution-chain :global(.pokemon-sprite){width:100px;height:100px}.evo-condition{font-size:.8rem;min-height:2.4em;margin:0}.evolution-chain li:first-child{padding-top:calc(16px + 2.4em)}.evolution-chain li>span{font-size:.8rem;color:#536477}#build-team{scroll-margin-top:16px}@media(max-width:600px){.guide-hero{gap:16px}.guide-hero :global(.pokemon-sprite){width:105px;height:105px}.guide-panel{padding:16px}.loadout{gap:8px}.loadout>div{padding:10px}.move-grid{grid-template-columns:repeat(2,1fr)}.advice-grid,.partner-grid{grid-template-columns:1fr}.evolution-chain{flex-direction:column}.evolution-chain li:first-child{padding-top:16px}.evolution-chain li+li::before{content:'↓';left:50%;top:-18px}.evo-condition{min-height:0}.guide-jumps{gap:14px}}
</style>
