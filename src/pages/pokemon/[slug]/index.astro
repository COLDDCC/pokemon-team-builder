---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import SiteHeader from '../../../components/SiteHeader.astro';
import SiteFooter from '../../../components/SiteFooter.astro';
import TeamBuilder from '../../../components/TeamBuilder';
import { featuredPokemonIds } from '../../../config/seo-pages';
import { pokemonById } from '../../../data/pokemon';
import { analyzeTeam } from '../../../lib/scoring';
export function getStaticPaths() { return featuredPokemonIds.map(slug => ({ params: {slug}, props: {pokemon: pokemonById.get(slug)!} })); }
const { pokemon: p } = Astro.props;
const analysis = analyzeTeam([p]);
const weak = analysis.defense.filter(row => row.weak.length);
const resist = analysis.defense.filter(row => row.resist.length);
---
<BaseLayout title={`${p.name} Team Builder, Weaknesses & Stats | Super Pokémon Team Builder`} description={`Build around ${p.name}, a ${p.types.join('/')} Pokémon. Review base stats, type weaknesses and computed teammate suggestions.`}><SiteHeader/><main id="main"><p class="eyebrow">POKÉDEX #{String(p.number).padStart(3, '0')} · GENERATION {p.generation}</p><h1>{p.name} Team Builder</h1><p class="intro">Start with {p.name}, then find teammates that complement its {p.types.join(' / ')} typing.</p><TeamBuilder initialPokemon={p.id} client:load/><section class="seo-content"><h2>{p.name} at a glance</h2><p>{p.name} is a {p.types.join(' / ')} base species introduced in Generation {p.generation}. The tool above starts with it in the first slot and recalculates as you add teammates.</p><div class="stats-grid">{Object.entries(p.stats).map(([name,value]) => <div><span>{({hp:'HP',atk:'Attack',def:'Defense',spa:'Sp. Attack',spd:'Sp. Defense',spe:'Speed'} as Record<string,string>)[name]}</span><strong>{value}</strong></div>)}</div><h3>Type weaknesses</h3><p>{weak.map(row => `${row.type} (${row.multipliers[0]}×)`).join(', ')}.</p><h3>Type resistances and immunities</h3><p>{resist.map(row => `${row.type} (${row.multipliers[0]}×)`).join(', ')}. These matchups depend on typing only; abilities and battle effects are excluded.</p><a href={`/pokemon/${p.id}/best-teammates`}>Explore computed {p.name} teammate suggestions →</a></section></main><SiteFooter/></BaseLayout>
