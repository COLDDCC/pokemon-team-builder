---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import SiteHeader from '../../../components/SiteHeader.astro';
import SiteFooter from '../../../components/SiteFooter.astro';
import GuideBreadcrumbs from '../../../components/GuideBreadcrumbs.astro';
import TeamBuilder from '../../../components/TeamBuilder';
import { featuredPokemonIds } from '../../../config/seo-pages';
import { pokemonById } from '../../../data/pokemon';
import { recommend } from '../../../lib/recommendations';
import { emptyTeam, setTeamSlot } from '../../../lib/url-state';
export function getStaticPaths() { return featuredPokemonIds.map(slug => ({ params: {slug}, props: {pokemon: pokemonById.get(slug)!} })); }
const { pokemon: p } = Astro.props;
const suggestions = recommend(setTeamSlot(emptyTeam(), 0, p.id), 1);
---
<BaseLayout title={`${p.name} Teammate Suggestions & Team Builder | Super Pokémon Team Builder`} description={`Find teammates for ${p.name} using type weaknesses, offensive coverage and base-stat synergy. Start a team with ${p.name} already selected.`}><SiteHeader/><main id="main"><GuideBreadcrumbs name={p.name} id={p.id} teammates/><p class="eyebrow">BUILD AROUND YOUR FAVORITE</p><h1>{p.name} Teammate Suggestions</h1><p class="intro">{p.name} is already selected. Add a teammate and see how the recommendations change with your whole team.</p><TeamBuilder initialPokemon={p.id} client:load/><section class="seo-content"><h2>First teammate candidates for {p.name}</h2><p>These candidates are calculated for a two-member team with {p.name}. They optimize our type-and-base-stat heuristic, rather than representing a competitive tier list. Add more teammates above for recommendations that use the updated team.</p><div class="static-suggestions">{suggestions.slice(0, 3).map(r => <article><h3>{r.pokemon.name} · +{r.delta} points</h3><p>{r.pokemon.types.join(' / ')} · Two-member score: {r.newScore}/100.</p><ul>{r.reasons.map(reason => <li>{reason}</li>)}</ul><a href={`/?v=1&format=gen9-national-casual&team=${p.id},${r.pokemon.id}`}>Try {p.name} + {r.pokemon.name} →</a></article>)}</div><h3>Why there is no universal best teammate</h3><p>A candidate can patch a type weakness but still conflict with your preferred strategy or moveset. Our recommendations change with each added or replaced member and exclude Pokémon already in the team.</p><a href={`/pokemon/${p.id}`}>See {p.name} stats and type matchups →</a></section></main><SiteFooter/></BaseLayout>
