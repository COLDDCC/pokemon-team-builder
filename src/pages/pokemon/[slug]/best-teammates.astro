---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import SiteHeader from '../../../components/SiteHeader.astro';
import SiteFooter from '../../../components/SiteFooter.astro';
import GuideBreadcrumbs from '../../../components/GuideBreadcrumbs.astro';
import TeamBuilder from '../../../components/TeamBuilder';
import { featuredPokemonIds } from '../../../config/seo-pages';
import { pokemonById } from '../../../data/pokemon';
import { recommend, sampleTeam } from '../../../lib/recommendations';
import PokemonSprite from '../../../components/PokemonSprite';
import SampleTeamLoader from '../../../components/SampleTeamLoader';
import { guideSchema } from '../../../lib/seo-schema';
import { teammateSeo } from '../../../lib/seo-text';
import { emptyTeam, setTeamSlot } from '../../../lib/url-state';
export function getStaticPaths() { return featuredPokemonIds.map(slug => ({ params: {slug}, props: {pokemon: pokemonById.get(slug)!} })); }
const { pokemon: p } = Astro.props;
const suggestions = recommend(setTeamSlot(emptyTeam(), 0, p.id), 1);
const seo = teammateSeo(p.name, suggestions.slice(0, 3).map(r => r.pokemon.name));
const schema = guideSchema(p.name, p.id, true, seo.title, seo.description);
const sample = sampleTeam(p.id);
---
<BaseLayout title={seo.title} description={seo.description} schema={schema}><SiteHeader/><main id="main"><GuideBreadcrumbs name={p.name} id={p.id} teammates/><p class="eyebrow">BUILD AROUND YOUR FAVORITE</p><h1>Best {p.name} Teammates</h1><p class="intro">{p.name} is already selected. Add a teammate and see how the recommendations change with your whole team.</p><TeamBuilder initialPokemon={p.id} client:load/><section class="seo-content"><h2>First teammate candidates for {p.name}</h2><p>These candidates are calculated for a two-member team with {p.name}. They optimize our type-and-base-stat heuristic, rather than representing a competitive tier list. Add more teammates above for recommendations that use the updated team.</p><div class="static-suggestions">{suggestions.slice(0, 6).map(r => <article><PokemonSprite pokemon={r.pokemon} sizes="160px"/><h3>{r.pokemon.name} · +{r.delta} points</h3><p>{r.pokemon.types.join(' / ')} · Two-member score: {r.newScore}/100.</p><ul>{r.reasons.map(reason => <li>{reason}</li>)}</ul>{featuredPokemonIds.some(id => id === r.pokemon.id) && <a href={`/pokemon/${r.pokemon.id}/`}>Read {r.pokemon.name} build →</a>}<a href="#team-title">Build with {p.name} →</a></article>)}</div><section class="sample-team"><h2>Sample {p.name} team</h2><p>Six unique Pokémon, filled by our deterministic scoring heuristic. Team score: <strong>{sample.score}/100</strong>. It is not a competitive legality guarantee.</p><div class="sample-roster">{sample.ids.map(id => { const member = pokemonById.get(id)!; return <article><PokemonSprite pokemon={member} sizes="120px"/><strong>{member.name}</strong><span>{member.types.join(" / ")}</span></article>; })}</div><SampleTeamLoader ids={sample.ids} client:load/></section><h3>Why there is no universal best teammate</h3><p>A candidate can patch a type weakness but still conflict with your preferred strategy or moveset. Our recommendations change with each added or replaced member and exclude Pokémon already in the team.</p><a href={`/pokemon/${p.id}/`}>See {p.name} stats and type matchups →</a></section></main><SiteFooter/></BaseLayout>

<style>.static-suggestions{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:14px}.static-suggestions article{min-width:0}.static-suggestions :global(.pokemon-sprite){display:block}.sample-team{margin:28px 0}.sample-roster{display:grid;grid-template-columns:repeat(6,minmax(0,1fr));gap:10px;margin:18px 0}.sample-roster article{min-width:0;display:flex;flex-direction:column;align-items:center;text-align:center;gap:6px;border:1px solid #dce5ed;background:#f5f8fc;border-radius:12px;padding:12px 6px;overflow-wrap:anywhere}.sample-roster :global(.pokemon-sprite){max-width:100%}.sample-roster span{font-size:.75rem;color:#52677e}@media(max-width:760px){.static-suggestions{grid-template-columns:repeat(2,minmax(0,1fr))}.sample-roster{grid-template-columns:repeat(3,minmax(0,1fr))}}@media(max-width:420px){.static-suggestions{grid-template-columns:1fr}.sample-roster{grid-template-columns:repeat(2,minmax(0,1fr))}}</style>
